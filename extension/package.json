{
  "name": "claude-doorman",
  "displayName": "Claude Doorman",
  "description": "Puts a complexity rubric in front of every Claude Code prompt and routes work to a model-tiered subagent.",
  "version": "0.1.0",
  "publisher": "emdef",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeDoorman.toggle",
        "title": "Doorman: Enable or disable"
      },
      {
        "command": "claudeDoorman.override",
        "title": "Doorman: Force a tier for the next prompt"
      },
      {
        "command": "claudeDoorman.showLog",
        "title": "Doorman: Open the log"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "package": "vsce package --out claude-doorman.vsix",
    "test:hook": "node hook/test-hook.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.7.2"
  }
}
