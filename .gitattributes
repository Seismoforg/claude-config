# LF for the check scripts. They are copied verbatim into the generated Copilot build, and this
# machine runs core.autocrlf=true — without the rule git restores CRLF on checkout while the build
# emits LF, so the source and its copy stop being byte-identical.
# The matching `github_build/** text eol=lf` rule is gone: the build is no longer committed
# (docs/adr/0003), so git never stores or restores those files.
scripts/*.mjs text eol=lf
